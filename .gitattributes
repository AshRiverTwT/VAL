# Normalize line endings so scripts always work when checked out on Ubuntu,
# regardless of whether the clone/checkout happens on Windows or Linux.
# Without this, Windows' autocrlf can silently turn "#!/usr/bin/env bash"
# into "#!/usr/bin/env bash\r", which fails on Linux with a cryptic
# "bad interpreter" error - a classic real-world Git/Linux gotcha.

* text=auto eol=lf

*.sh text eol=lf
Jenkinsfile text eol=lf
*.java text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.service text eol=lf

*.jar binary
*.png binary
*.jpg binary
