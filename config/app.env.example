# =========================================================================
# Example environment file.
#
# Copy this to a real env file that is NEVER committed to Git, e.g.:
#   cp config/app.env.example config/app.env
#
# Used by:
#   - systemd/valorant-app.service   (EnvironmentFile=)
#   - docker compose --env-file config/app.env
#   - scripts/deploy.sh
#
# Do not put real secrets in an app.env file that gets committed. This
# project has no secrets to manage, but this pattern is exactly how you
# would keep API keys/passwords out of Git in a real project.
# =========================================================================

APP_ENV=production
APP_VERSION=
BUILD_NUMBER=local
GIT_COMMIT=unknown
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Which Docker image tag docker-compose.yml should run (see scripts/deploy.sh)
APP_IMAGE_TAG=local
